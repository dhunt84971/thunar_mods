@@ -4594,6 +4604,133 @@ thunar_window_check_uca_key_activation (ThunarWindow *window,
 
 
 
+/**
+ * thunar_window_type_ahead_search:
+ * @window     : a #ThunarWindow.
+ * @key_event  : the #GdkEventKey which triggered the callback.
+ * @user_data  : unused.
+ *
+ * Starts (or extends) a search for the typed text as soon as the user types a
+ * printable character into the window, the way Nautilus does it. The character
+ * is pushed into the search entry of the location bar, which drives the regular
+ * Thunar search; whether that search descends into subfolders is decided by the
+ * "misc-recursive-search" preference.
+ *
+ * Keys which carry a modifier, keys which do not produce a printable character,
+ * keys which are bound to an accelerator and all key presses which happen while
+ * a text entry is focused (the location bar, the search entry itself, inline
+ * renaming) are left untouched.
+ *
+ * Return value: %GDK_EVENT_STOP if the key press was consumed to search,
+ *               %GDK_EVENT_PROPAGATE otherwise.
+ **/
+static gboolean
+thunar_window_type_ahead_search (ThunarWindow *window,
+                                 GdkEventKey  *key_event,
+                                 gpointer      user_data)
+{
+  GtkWidget       *focused_widget;
+  GdkModifierType  modifiers;
+  gunichar         character;
+  gboolean         type_ahead_search;
+  gchar            buffer[8];
+  gchar           *text;
+  gint             length;
+
+  _thunar_return_val_if_fail (THUNAR_IS_WINDOW (window), GDK_EVENT_PROPAGATE);
+
+  /* the feature can be switched off in the preferences */
+  g_object_get (G_OBJECT (window->preferences), "misc-type-ahead-search", &type_ahead_search, NULL);
+  if (type_ahead_search == FALSE)
+    return GDK_EVENT_PROPAGATE;
+
+  /* there needs to be a view and a folder to search in */
+  if (window->view == NULL || window->current_directory == NULL || window->location_bar == NULL)
+    return GDK_EVENT_PROPAGATE;
+
+  /* only react on plain key presses; <Shift> is fine, since it just picks the character */
+  modifiers = key_event->state & gtk_accelerator_get_default_mod_mask ();
+  if ((modifiers & ~GDK_SHIFT_MASK) != 0)
+    return GDK_EVENT_PROPAGATE;
+
+  /* never steal key presses from a text entry: that covers the location bar, the
+   * search entry itself and the entry used for inline renaming */
+  focused_widget = gtk_window_get_focus (GTK_WINDOW (window));
+  if (focused_widget != NULL && (GTK_IS_EDITABLE (focused_widget) || GTK_IS_TEXT_VIEW (focused_widget)))
+    return GDK_EVENT_PROPAGATE;
+
+  /* only printable characters start a search, so that Escape, Delete, F2, the arrow
+   * keys and friends keep doing what they always did. Space is excluded as well,
+   * since it toggles the selection in the views */
+  character = gdk_keyval_to_unicode (key_event->keyval);
+  if (character == 0 || g_unichar_iscntrl (character) || g_unichar_isspace (character)
+      || !g_unichar_isprint (character))
+    return GDK_EVENT_PROPAGATE;
+
+  /* an accelerator bound to this very key wins over the type-ahead search */
+  if (window->accel_group != NULL
+      && gtk_accel_group_query (window->accel_group, key_event->keyval, modifiers, NULL) != NULL)
+    return GDK_EVENT_PROPAGATE;
+
+  /* '/' and '~' open the location bar instead (see thunar_standard_view_key_press_event) */
+  if (key_event->keyval == GDK_KEY_slash || key_event->keyval == GDK_KEY_asciitilde
+      || key_event->keyval == GDK_KEY_dead_tilde)
+    return GDK_EVENT_PROPAGATE;
+
+  /* the typed character, as UTF-8 */
+  length = g_unichar_to_utf8 (character, buffer);
+  buffer[length] = '\0';
+
+  if (window->is_searching == TRUE)
+    {
+      /* a search is already running, so append the character to the current query */
+      text = g_strconcat (SEARCH_PREFIX, window->search_query != NULL ? window->search_query : "", buffer, NULL);
+
+      /* the location toolbar may be hidden by the user */
+      gtk_widget_show (window->location_toolbar);
+
+      /* hand the keyboard focus back to the search entry, which drives the search */
+      thunar_location_bar_request_entry (THUNAR_LOCATION_BAR (window->location_bar), text, FALSE);
+    }
+  else
+    {
+      /* start a new search, seeded with the typed character */
+      text = g_strconcat (SEARCH_PREFIX, buffer, NULL);
+      thunar_window_start_open_location (window, text);
+      thunar_window_set_search_button_active (window, TRUE);
+    }
+
+  g_free (text);
+
+  return GDK_EVENT_STOP;
+}
+
+
+
+/**
+ * thunar_window_set_search_button_active:
+ * @window : a #ThunarWindow.
+ * @active : whether the search toolbar item should appear pressed.
+ *
+ * Updates the toggle state of the search toolbar item without re-entering
+ * thunar_window_action_search().
+ **/
+static void
+thunar_window_set_search_button_active (ThunarWindow *window,
+                                        gboolean      active)
+{
+  _thunar_return_if_fail (THUNAR_IS_WINDOW (window));
+
+  if (window->location_toolbar_item_search == NULL)
+    return;
+
+  g_signal_handlers_block_by_func (G_OBJECT (window->location_toolbar_item_search), thunar_window_action_search, window);
+  gtk_toggle_tool_button_set_active (GTK_TOGGLE_TOOL_BUTTON (window->location_toolbar_item_search), active);
+  g_signal_handlers_unblock_by_func (G_OBJECT (window->location_toolbar_item_search), thunar_window_action_search, window);
+}
+
+
+
 static gboolean
 thunar_window_propagate_key_event (GtkWindow* window,
                                    GdkEvent  *key_event,
