 };
 
@@ -1205,6 +1206,24 @@ thunar_preferences_class_init (ThunarPreferencesClass *klass)
                          100,
                          EXO_PARAM_READWRITE);
 
+  /**
+   * ThunarPreferences:misc-type-ahead-search
+   *
+   * Whether typing a printable character while the window is focused
+   * (and no text entry has the keyboard focus) immediately starts a
+   * search for that text, instead of the interactive "jump to the next
+   * matching name in this folder" behaviour of the GTK views.
+   *
+   * How deep that search goes is controlled by
+   * ThunarPreferences:misc-recursive-search.
+   **/
+  preferences_props[PROP_MISC_TYPE_AHEAD_SEARCH] =
+      g_param_spec_boolean ("misc-type-ahead-search",
+                            "MiscTypeAheadSearch",
+                            NULL,
+                            TRUE,
+                            EXO_PARAM_READWRITE);
+
   /* install all properties */
   g_object_class_install_properties (gobject_class, N_PROPERTIES, preferences_props);
 }
