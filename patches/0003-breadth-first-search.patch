@@ -43,6 +43,19 @@
 #include <thunar/thunar-simple-job.h>
 #include <thunar/thunar-util.h>
 
+/* Delay between the search query changing and its crawl actually starting.
+ * Typing a word fires one "changed" per character, and each one replaces the
+ * running search, so without this a four-letter query starts and throws away
+ * four crawls. Nautilus does the same thing with CREATE_THREAD_DELAY_MS. */
+#define THUNAR_SEARCH_START_DELAY 250
+
+/* how often the matches found so far are inserted into the model */
+#define THUNAR_SEARCH_UPDATE_INTERVAL 500
+
+/* commit matches while still inside one directory, every this many entries */
+#define THUNAR_SEARCH_COMMIT_BATCH 500
+
+
 
 
 /* Property identifiers */
@@ -236,6 +249,9 @@ static void               thunar_list_model_search_error                (ThunarJ
 static void               thunar_list_model_search_finished             (ThunarJob                    *job,
                                                                          ThunarListModel              *store);
 static gboolean           thunar_list_model_add_search_files            (gpointer user_data);
+static gboolean           thunar_list_model_launch_search_job           (gpointer user_data);
+static void               thunar_list_model_search_commit               (ThunarListModel              *model,
+                                                                         GList                       **files_found);
 
 static gint               thunar_list_model_get_folder_item_count       (ThunarListModel              *store);
 static void               thunar_list_model_set_folder_item_count       (ThunarListModel              *store,
@@ -309,6 +325,10 @@ struct _ThunarListModel
 
   /* used to stop the periodic call to thunar_list_model_add_search_files when the search is finished/canceled */
   guint          update_search_results_timeout_id;
+
+  /* set while a changed search query is waiting out THUNAR_SEARCH_START_DELAY,
+   * before its job is actually launched */
+  guint          search_job_launch_timeout_id;
 };
 
 
@@ -2251,6 +2271,57 @@ thunar_list_model_set_job (ThunarListModel  *store,
 
 
 
+/**
+ * thunar_list_model_search_commit:
+ * @model       : a #ThunarListModel.
+ * @files_found : list of #ThunarFile<!---->s found so far; emptied here.
+ *
+ * Makes the matches found so far visible to the next
+ * thunar_list_model_add_search_files() run.
+ **/
+static void
+thunar_list_model_search_commit (ThunarListModel  *model,
+                                 GList           **files_found)
+{
+  if (*files_found == NULL)
+    return;
+
+  g_mutex_lock (&model->mutex_files_to_add);
+  model->files_to_add = g_list_concat (model->files_to_add, *files_found);
+  g_mutex_unlock (&model->mutex_files_to_add);
+
+  *files_found = NULL;
+}
+
+
+
+/**
+ * thunar_list_model_launch_search_job:
+ * @user_data : a #ThunarListModel.
+ *
+ * Starts the search job prepared by thunar_list_model_set_folder(), once the
+ * query has been left alone for THUNAR_SEARCH_START_DELAY.
+ **/
+static gboolean
+thunar_list_model_launch_search_job (gpointer user_data)
+{
+  ThunarListModel *store = THUNAR_LIST_MODEL (user_data);
+
+  store->search_job_launch_timeout_id = 0;
+
+  if (store->recursive_search_job == NULL)
+    return G_SOURCE_REMOVE;
+
+  exo_job_launch (EXO_JOB (store->recursive_search_job));
+
+  /* add new results to the model every X ms */
+  store->update_search_results_timeout_id = g_timeout_add (THUNAR_SEARCH_UPDATE_INTERVAL, thunar_list_model_add_search_files, store);
+
+  return G_SOURCE_REMOVE;
+}
+
+
+
