 static void
 thunar_list_model_cancel_search_job (ThunarListModel *model)
 {
+  /* drop a search which was prepared but has not started crawling yet */
+  if (model->search_job_launch_timeout_id > 0)
+    {
+      g_source_remove (model->search_job_launch_timeout_id);
+      model->search_job_launch_timeout_id = 0;
+    }
